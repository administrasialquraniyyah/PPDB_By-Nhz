# SUPABASE POSTGRES CONNECTION
# Gunakan Port 6543 (Transaction Mode) untuk Vercel Serverless & Prisma agar koneksi cepat dan tidak timeout:
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?schema=ppdb&pgbouncer=true&connection_limit=1"
# Gunakan Port 5432 (Session Mode) untuk Direct / Migrasi:
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=ppdb"

# SUPABASE CLIENT CONFIG (Public)
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_APP_NAME="PPDB Al-Qur'aniyyah"
NEXT_PUBLIC_PESANTREN_NAME="Pondok Pesantren Al-Qur'aniyyah"
NEXT_PUBLIC_YAYASAN_NAME="Yayasan Pendidikan Islam Al-Qur'aniyyah"
